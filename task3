#include <Wire.h>
#include <BH1750.h>
#include <WiFiNINA.h>
#include <PubSubClient.h>
// Wi-Fi Details
#define WIFI_SSID "1234578"
#define WIFI_PASSWORD "12345678"
// HiveMQ Cloud Details
#define MQTT_SERVER "d0fc2839748e43389d5b74aff3fd2e6e.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883

#define MQTT_USER "sarthak"
#define MQTT_PASSWORD "12345678"

// MQTT Topic
#define MQTT_TOPIC "sensor/light"
// Objects
BH1750 lightMeter;

WiFiSSLClient wifiClient;
PubSubClient mqttClient(wifiClient);
// Connect to Wi-Fi
void connectWiFi() {

  Serial.print("Connecting to Wi-Fi");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("Wi-Fi connected!");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
}
// Connect to HiveMQ
void connectMQTT() {

  while (!mqttClient.connected()) {

    Serial.print("Connecting to HiveMQ...");

    if (mqttClient.connect(
          "ArduinoNano33IoT",
          MQTT_USER,
          MQTT_PASSWORD
        )) {

      Serial.println("Connected to HiveMQ!");

    } else {

      Serial.print("Failed, MQTT state = ");
      Serial.println(mqttClient.state());

      Serial.println("Trying again in 5 seconds...");
      delay(5000);
    }
  }
}
// Setup
void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("BH1750 Light Sensor + MQTT");

  // Start I2C
  Wire.begin();

  // Start BH1750
  if (lightMeter.begin()) {

    Serial.println("BH1750 sensor started successfully.");

  } else {

    Serial.println("ERROR: BH1750 sensor not found!");

    while (1);
  }

  // Connect to Wi-Fi
  connectWiFi();

  // Set HiveMQ server
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);

  // Connect to HiveMQ
  connectMQTT();
}
// Main Loop
void loop() {

  // Reconnect if MQTT connection is lost
  if (!mqttClient.connected()) {
    connectMQTT();
  }

  // Keep MQTT connection alive
  mqttClient.loop();

  // Read light level
  float lux = lightMeter.readLightLevel();

  // Display light value
  Serial.print("Light: ");
  Serial.print(lux);
  Serial.println(" lx");

  // Convert lux value to text
  String lightMessage = String(lux, 2);

  // Publish to HiveMQ
  if (mqttClient.publish(MQTT_TOPIC, lightMessage.c_str())) {

    Serial.print("Published to ");
    Serial.print(MQTT_TOPIC);
    Serial.print(": ");
    Serial.println(lightMessage);

  } else {

    Serial.println("Failed to publish MQTT message.");
  }

  // Send every 5 seconds
  delay(5000);
}
